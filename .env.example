# --- Connection (Entra ID service principal / client credentials) -----------
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-app-registration-client-id
AZURE_CLIENT_SECRET=your-client-secret
# Default subscription used when a tool omits one.
AZURE_SUBSCRIPTION_ID=
AZURE_TIMEOUT_MS=30000

# --- Governance & security flags -------------------------------------------
# Access mode: read-only | read-write | admin. Start with read-only.
AZURE_MODE=read-only
# Comma-separated subscription allowlist. Empty = all the SP can see.
AZURE_SUBSCRIPTION_ALLOWLIST=
# Comma-separated resource-group allowlist. Empty = all.
AZURE_RESOURCE_GROUP_ALLOWLIST=
# Resource groups that can be read but never mutated/deleted.
AZURE_PROTECTED_RESOURCE_GROUPS=
# New resource groups may only be created in these regions. Empty = any.
AZURE_LOCATION_ALLOWLIST=
# delete_* tools require this in addition to admin mode.
AZURE_ALLOW_DELETE=false
# High-impact deletes require a typed confirmation matching the target name.
AZURE_REQUIRE_CONFIRMATION=true
# Validate + log writes without calling Azure.
AZURE_DRY_RUN=false
# Emit a JSON audit line to stderr per guarded operation.
AZURE_AUDIT_LOG=true

# --- AI risk guard (optional; needs a running laya-guard daemon) -------------
# High-risk ops ask a LOCAL laya-guard daemon to classify them allow / confirm / block. Runs AFTER
# the deterministic gates; only tightens, never grants; fails closed.  off | monitor | enforce
AZURE_GUARD_MODE=off
AZURE_GUARD_URL=http://127.0.0.1:8799
AZURE_GUARD_TIMEOUT_MS=2000
AZURE_GUARD_FAIL_CLOSED=confirm
